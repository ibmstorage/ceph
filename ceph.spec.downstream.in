BuildRequires:	which
BuildRequires:	xfsprogs-devel
BuildRequires:	xmlstarlet
BuildRequires:	nasm
BuildRequires:	lua-devel
BuildRequires:  lmdb-devel
%if 0%{with crimson} || 0%{with jaeger}
